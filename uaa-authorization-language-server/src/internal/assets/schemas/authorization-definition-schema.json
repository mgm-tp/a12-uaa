{
	"$schema": "http://json-schema.org/draft-07/schema",
	"type": "object",
	"examples": [
		{
			"name": "",
			"description": "",
			"policies": [],
			"repositoryPolicies": [],
			"permissions": [],
			"propertyRights": [],
			"propertyPermissions": []
		}
	],
	"properties": {
		"name": {
			"type": "string",
			"minLength": 1
		},
		"description": {
			"type": "string"
		},
		"policies": {
			"description": "A list of policies that can be referenced from Permission and PropertyPermission.",
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "file://policy-schema.json"
			}
		},
		"repositoryPolicies": {
			"description": "A list of repository polices that can be referenced from Permission.",
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "file://repositoryPolicy-schema.json"
			}
		},
		"permissions": {
			"description": "A list of permissions that define what actions a user can perform.",
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "file://permission-schema.json"
			}
		},
		"propertyRights": {
			"description": "A list of property rights that can be referenced from PropertyPermission.",
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "file://propertyRight-schema.json"
			}
		},
		"propertyPermissions": {
			"description": "A list of property permissions that specify which properties a user can access and what actions they can perform.",
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "file://propertyPermission-schema.json"
			}
		}
	},
	"required": ["name"],
	"additionalProperties": false,
	"allOf": [
		{
			"if": {
				"anyOf": [
					{
						"required": ["permissions"],
						"properties": {
							"permissions": {
								"contains": {
									"required": ["policy-refs"],
									"properties": {
										"policy-refs": {
											"minItems": 1
										}
									}
								}
							}
						}
					},
					{
						"required": ["propertyPermissions"],
						"properties": {
							"propertyPermissions": {
								"contains": {
									"required": ["policy-refs"],
									"properties": {
										"policy-refs": {
											"minItems": 1
										}
									}
								}
							}
						}
					}
				]
			},
			"then": {
				"required": ["policies"]
			}
		},
		{
			"if": {
				"anyOf": [
					{
						"required": ["permissions"],
						"properties": {
							"permissions": {
								"contains": {
									"required": ["repository-refs"],
									"properties": {
										"repository-refs": {
											"minItems": 1
										}
									}
								}
							}
						}
					},
					{
						"required": ["propertyPermissions"],
						"properties": {
							"propertyPermissions": {
								"contains": {
									"required": ["repository-refs"],
									"properties": {
										"repository-refs": {
											"minItems": 1
										}
									}
								}
							}
						}
					}
				]
			},
			"then": {
				"required": ["repositoryPolicies"]
			}
		},
		{
			"if": {
				"required": ["propertyPermissions"],
				"properties": {
					"propertyPermissions": {
						"contains": {
							"required": ["rights-refs"],
							"properties": {
								"rights-refs": {
									"minItems": 1
								}
							}
						}
					}
				}
			},
			"then": {
				"required": ["propertyRights"]
			}
		}
	]
}
