{
	"$schema": "http://json-schema.org/draft-07/schema",
	"type": "object",
	"contentMediaType": "application/json",
	"examples": [
		{
			"name": "",
			"description": "",
			"rights": {
				"READ": [],
				"WRITE": [],
				"MASK": []
			}
		}
	],
	"identityProperty": "name",
	"required": ["name", "rights"],
	"properties": {
		"name": {
			"description": "The identifier of PropertyRight.",
			"type": "string",
			"minLength": 1
		},
		"description": {
			"type": "string"
		},
		"rights": {
			"description": "The right that user actions can perform on resource properties.",
			"type": "object",
			"properties": {
				"READ": {
					"description": "A list of property paths that the user is allowed to read.",
					"type": "array",
					"uniqueItems": true,
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"WRITE": {
					"description": "A list of property paths that the user is allowed to write.",
					"type": "array",
					"uniqueItems": true,
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"MASK": {
					"description": "A list of expressions return masking data that will be displayed instead of the actual data.",
					"type": "array",
					"uniqueItems": true,
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"anyOf": [
				{
					"required": ["READ"]
				},
				{
					"required": ["WRITE"]
				}
			],
			"additionalProperties": false
		}
	},
	"additionalProperties": false
}
