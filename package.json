{
	"name": "@com.mgmtp.a12.uaa/uaa-monorepo",
	"private": true,
	"type": "module",
	"description": "A12 UAA Monorepo",
	"workspaces": [
		"uaa-authentication-client",
		"uaa-authentication-a12-client",
		"uaa-authentication-client-codemod",
		"uaa-authorization-language-server",
		"uaa-regression-tests",
		"devapps/uaa-example-app-client"
	],
	"scripts": {
		"compile": "npm run compile --workspaces --if-present",
		"clean": "npm run clean --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"lint": "npm-run-all -p lint:*",
		"lint:eslint": "eslint --quiet",
		"lint:prettier": "prettier \"**/*.{ts,tsx}\" --check",
		"format": "npm-run-all -p format:*",
		"format:eslint": "eslint --quiet --fix",
		"format:prettier": "prettier \"**/*.{ts,tsx}\" --write",
		"postinstall": "node scripts/check-hoisting.mjs"
	},
	"devDependencies": {
		"@com.mgmtp.a12.devtools/tsconfig": "^1.1.0",
		"@com.mgmtp.a12.devtools/eslint-config": "^3.1.0",
		"@com.mgmtp.a12.devtools/prettier-config": "^1.1.0",
		"@cyclonedx/cyclonedx-npm": "^4.1.2",
		"ajv": "^8.17.1",
		"@eslint/compat": "^1.2.4",
		"@jambit/eslint-plugin-typed-redux-saga": "^0.4.0",
		"@stylistic/eslint-plugin": "^5.4.0",
		"eslint": "^9.23.0",
		"eslint-plugin-notice": "^1.0.0",
		"eslint-plugin-perfectionist": "^4.11.0",
		"eslint-plugin-unused-imports": "^4.1.4",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.5.3",
		"redux-saga": "1.2.3",
		"vitest": "3.2.4"
	},
	"engines": {
		"node": ">=22"
	},
	"overrides": {
		"react-redux": {
			"react": "^19"
		}
	}
}
