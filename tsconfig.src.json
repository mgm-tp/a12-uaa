{
	"extends": "./tsconfig.base.json",
	"include": ["${configDir}/src/**/*.ts", "${configDir}/src/**/*.tsx", "${configDir}/src/**/*.json"],
	"compilerOptions": {
		"composite": true,
		"noEmit": false,
		"rootDir": "${configDir}/src",
		"outDir": "${configDir}/lib",
		"tsBuildInfoFile": "${configDir}/target/tsbuildinfo"
	}
}
