				"Guest"
			],
			"rights-refs": [
				"Guest Data"
			]
		}
	],
	"propertyRights": [
		{
			"name": "Admin Data",
			"description": "",
			"rights": {
				"READ": [
					"id",
					"name",
					"description",
					"nested",
