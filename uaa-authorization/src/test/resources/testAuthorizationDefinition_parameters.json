				"#parameter + ' ' + principal.username"
			]
		},
		{
			"name": "RepositoryPolicyPlain",
			"description": "Repos",
			"templates": [
				"'parameter ' + principal.username"
			]
		},
		{
			"name": "Repository_Policy_Ref",
			"description": "Repos",
			"templates": [
