{
	"name": "Test Permission Definition",
	"description": "",
	"policies": [
		{
			"name": "Success",
			"description": "Return always true",
			"rules": [
				"true"
			]
		},
		{
			"name": "Failure",
			"description": "Return always false",
			"rules": [
				"false"
			]
		},
		{
			"name": "Success And Or",
			"description": "Return always true",
			"rules": [
				"true &&  true || false"
			]
		},
		{
			"name": "Failure And Or",
			"description": "Return always true",
			"rules": [
				"false || true && true && false && true"
			]
		},
		{
			"name": "BadSyntax",
			"description": "In the old one it is a stupid policy, but now It has changed",
			"rules": [
				"'this is totally stupid policy'"
			]
		},
		{
			"name": "RepositoryPolicy",
			"description": "Repos",
			"target": "#resource.first == 'one'",
			"dataPreload": [
				"#newResource = '100_Percents'"
			],
			"rules": [
				"'The rule must have'"
			]
		},
		{
			"name": "Filterred Policy",
			"description": "Repos",
			"target": "false",
			"rules": [
				"false"
			]
		},
{
			"name": "Target True",
			"description": "target evaluated as true",
			"target": "true",
			"rules": [
				"false"
			]
		},
		{
			"name": "Target False",
			"description": "target evaluated as false",
			"target": "false",
			"rules": [
				"false"
			]
		},
		{
			"name": "Admin User",
			"description": "check if user is admin",
			"rules": [
				"#principal.username == 'admin'"
			]	
		},
		{
			"name": "Guest User",
			"description": "check if user is guest",
			"rules": [
				"#principal.username == 'guest'"
			]	
		}
	],
	"repositoryPolicies": [
	{
			"name": "RepositoryPolicy",
			"description": "Repos",
			"target": "#resource.first == 'one'",
			"dataPreload": [
				"#newResource = '100_Percents'"
			],
			"templates": [
				"#resource.first",
				"#resource.second",
				"'country.specificName=''' + #newResource + '''' + ' && ' + 'country.name=''' + #newResource + ''''",
				{
					"operator": "exact_match",
					"field": "/country_code",
					"value": "'_' + #newResource",
					"array": [
						"#newResource",
						"item"
					]
				}
			]
		},
		{
			"name": "RepositoryPolicyRef",
			"description": "Repos",
			"templates": [
				"'The template must have'"
			]
		}
	],
	"permissions": [
