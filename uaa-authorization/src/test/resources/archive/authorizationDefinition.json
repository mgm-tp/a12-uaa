{
	"name": "Policy Authorization Object",
	"authorizationData": [
		{
			"name": "Test Controller",
			"dataTypes": [
				{
					"name": "Insurance Policy Manager",
					"rules": [
						"hasRole('Policy Manager')"
					],
					"rights": [
						"READX",
						"DELETE"
					]
				}
			]
		},
		{
			"name": "Insurance policy",
			"dataTypes": [
				{
					"name": "Insurance Policy Manager",
					"rules": [
						"hasRole('Policy Manager')"
					],
					"rights": [
						"READ",
						"DELETE"
					],
					"filterQuery": "policy.country=env.country AND policy.department=#user.dept",
					"properties": [
						{
							"name": "Policy Tax Verification",
							"rules": [
								"#policy.tax>1000 && #user.department contains ('CARGO')"
							],
							"rights": {
								"READ": [
									"#policy.contract.type",
									"#policy.type",
									"#policy.period"
								],
								"WRITE": [
								]
							}
						},
						{
							"name": "Policy Period Verification",
							"rules": [
								"#policy.period>1000 && #user.department contains ('CAR')"
							],
							"rights": {
								"READ": [
									"#policy.period"
								],
								"WRITE": [
								]
							}
						}
					]
				},
				{
					"name": "Insurance Policy Reviewer",
					"rules": [
						"#policy.period > 1year",
						"#policy.timeline inrange (2010, 2020)"
					],
					"rights": [
						"READ",
						"READ-ONLY"
					],
					"filterQuery": "policy.period < 1year AND policy.timeline IN (2010, 2020)",
					"properties": [
						{
							"name": "Policy Tax Verification",
							"rules": [
								"#policy.tax>1000 && #user.department contains ('CARGO')"
							],
							"rights": {
								"READ": [
									"#policy.contract.type",
									"#policy.type",
									"#policy.period"
								],
								"WRITE": [
								]
							}
						},
						{
							"name": "Policy Period Verification",
							"rules": [
								"#policy.period>1000 && #user.department contains ('CAR')"
							],
							"rights": {
								"READ": [
									"#policy.period"
								],
								"WRITE": [
								]
							}
						}
					]
				},
				{
					"name": "Insurance Policy Contract",
					"rules": [
						"#policy.contract != null & #policy.contract.period == '30days'",
						"#contract.type == '2 years' & #contract.timeline in (2010,2015)"
					],
					"rights": [
						"ACCESS",
						"VIEW"
					],
					"filterQuery": "policy.contract IS NOT EMPTY AND policy.contract in (SELECT contract_id FROM Contract where contract.employee = #user.username)",
					"properties": [
						{
							"name": "Policy Tax Verification",
							"rules": [
								"#policy.tax>1000 && #user.department contains ('CARGO')"
							],
							"rights": {
								"READ": [
									"#policy.type",
									"#policy.period"
								],
								"WRITE": [
								]
							}
						},
						{
							"name": "Policy Period Verification",
							"rules": [
								"#policy.period>1000 && #user.department contains ('CAR')"
							],
							"rights": {
								"READ": [
									"#policy.period"
								],
								"WRITE": [
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "Insurance policy Children",
			"parent": "Insurance policy",
			"dataTypes": [
				{
					"name": "Insurance Policy Type",
					"rules": [
						"#user.role='Policy Manager'",
						"#policy.type != null"
					],
					"rights": [
						"READ",
						"DELETE"
					],
					"filterQuery": "policy.country=#env.country AND policy.department=#user.dept",
