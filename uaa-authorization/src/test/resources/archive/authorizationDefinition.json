						{
							"name": "POLICY",
							"rules": [
								"#object.tax>1000 && #user.department contains ('CARGO')"
							],
							"rights": {
								"READ": [
									"#policy.contract.type",
									"#policy.type",
									"#policy.period"
								],
								"WRITE": [
								]
							}
						}
					]
				},
				{
					"name": "Insurance Policy Manager DEMO",
					"rules": [
						"hasRole('Policy Manager')",
						"#xyz == 2",
						"#theRest.contract.type == one_month",
						"#contract.year == 2019"
					],
					"rights": [
						"READ",
						"DELETE"
					]
				}
			]
		},
		{
			"name": "Organization",
			"dataTypes": [
				{
