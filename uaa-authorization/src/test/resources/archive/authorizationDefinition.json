					],
					"rights": [
						"READ",
						"DELETE"
					],
					"filterQuery": "policy.country=env.country AND policy.department=#user.dept",
					"properties": [
						{
							"name": "Policy Tax Verification",
							"rules": [
								"#policy.tax>1000 && #user.department contains ('CARGO')"
							],
							"rights": {
								"READ": [
									"#policy.contract.type",
									"#policy.type",
									"#policy.period"
								],
								"WRITE": [
								]
							}
						},
						{
							"name": "Policy Period Verification",
							"rules": [
								"#policy.period>1000 && #user.department contains ('CAR')"
							],
							"rights": {
								"READ": [
								],
								"WRITE": [
									"#policy.period"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "Policy Manager",
			"dataTypes": [
				{
					"name": "Organization Manager",
					"rules": [
						"hasRole('Policy Manager') && principal.user.organization.name == 'FirstOrg'"
					],
					"rights": [
						"READ",
						"DELETE"
					],
					"properties": [
						{
							"name": "Family Property Authorize",
							"rules": [
								"principal.user.organization.name == 'FirstOrg'"
							],
							"rights": {
								"READ": [
									"addressObjects/2.streetName",
									"childrenAndAge/Vi.age",
									"addressObjects",
									"childrenAndAge",
									"primaryAddress.streetName"
								],
								"WRITE": [
									"childrenAndAge/Hung",
									"addressObjects/1.number",
									"primaryAddress.streetName"
								]
							}
						},
						{
							"name": "Country Properties",
							"rules": [
								"principal.user.organization.name == 'FirstOrg'"
							],
							"rights": {
								"READ": [
								],
								"WRITE": [
