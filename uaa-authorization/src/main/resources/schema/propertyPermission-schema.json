{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "examples": [
    {
      "name": "",
      "description": "",
      "policy-refs": [],
      "policies": [],
      "rights-refs": []
    }
  ],
  "identityProperty": "name",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "description": "The identifier of PropertyPermission.",
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "policy-refs": {
      "description": "An array of Policy name (identifier) references.",
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "expressionType": "UAAExpression",
        "$uaa-ref-in": "/policies"
      }
    },
    "policies": {
      "description": "An array of inline policy template definition.",
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "expressionType": "SpEL"
      }
    },
    "rights-refs": {
      "description": "An array of PropertyRight name (identifier) references.",
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "$uaa-ref-in": "/propertyRights"
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "policy-refs"
      ]
    },
    {
      "required": [
        "policies"
      ]
    },
    {
      "required": [
        "rights-refs"
      ]
    },
    {
      "required": [
        "repository-refs"
      ]
    }
  ],
  "additionalProperties": false
}
