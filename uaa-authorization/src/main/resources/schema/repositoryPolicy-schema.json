{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "examples": [
    {
      "name": "",
      "description": "",
      "target": "",
      "dataPreload": [],
      "templates": []
    }
  ],
  "identityProperty": "name",
  "required": [
    "name",
    "templates"
  ],
  "properties": {
    "name": {
      "description": "The identifier of RepositoryPolicy.",
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "target": {
      "description": "A quick expression used to filter out the RepositoryPolicy if it matches or not.",
      "type": "string",
      "minLength": 1,
      "expressionType": "SpEL"
    },
    "dataPreload": {
      "description": "An array of expressions used to prepare all data which can be referenced in template execution.",
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "expressionType": "SpEL"
      }
    },
    "templates": {
      "description": "Variables can be used in repos.",
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": ["string","object"],
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "expressionType": "SpEL"
          },
          {
            "type": "object"
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
